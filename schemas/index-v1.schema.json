{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/task-v1/luminesk-database/main/schemas/index-v1.schema.json",
  "title": "Luminesk database index v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["indexVersion", "revision", "entries"],
  "properties": {
    "indexVersion": {"const": 1},
    "revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "entries": {
      "type": "array",
      "maxItems": 10000,
      "items": {"$ref": "#/$defs/entry"}
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$"
    },
    "recipePath": {
      "type": "string",
      "pattern": "^database/[a-z0-9](?:[a-z0-9._-]{0,126}[a-z0-9])?$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "displayName",
        "recipeVersion",
        "kind",
        "game",
        "edition",
        "summary",
        "keywords",
        "path",
        "manifestDigest"
      ],
      "properties": {
        "name": {"$ref": "#/$defs/identifier"},
        "displayName": {"type": "string", "minLength": 1},
        "recipeVersion": {"$ref": "#/$defs/semver"},
        "kind": {"enum": ["core", "template"]},
        "game": {"const": "minecraft"},
        "edition": {"enum": ["java", "bedrock", "cross-platform"]},
        "summary": {"type": "string", "minLength": 1},
        "keywords": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "license": {"type": "string", "minLength": 1},
        "authors": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "platforms": {
          "type": "array",
          "items": {"type": "string", "pattern": "^[a-z0-9]+/[a-z0-9][a-z0-9_-]*$"}
        },
        "repository": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "sourceTypes": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "runtimeImage": {"type": "string", "minLength": 1},
        "path": {"$ref": "#/$defs/recipePath"},
        "manifestDigest": {"$ref": "#/$defs/digest"},
        "templateDigest": {"$ref": "#/$defs/digest"}
      }
    }
  },
  "$comment": "Entries must be sorted by name, normalized names must be unique, and each path must equal database/<name>; the CLI enforces these semantic constraints."
}
